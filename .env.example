# Optional Node OAuth. Browser-token mode needs no .env or backend.
# Create a GitHub OAuth App. Callback: http://127.0.0.1:5173/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Production: PUBLIC_ORIGIN=https://your-domain.example and PORT=3000
PORT=3000
# Persistent disk path; not served directly. Back up with the UI export.
TOWN_DATA_FILE=private/town.json
# Each town has a private ownership envelope and public exportable snapshot.
TOWN_DATA_DIR=private/towns
# Any OAuth-authenticated user may publish their own town.
# Optional GITHUB_ALLOWED_LOGIN can administer towns and choose the default.
# Exploration is stored only in the visitor's browser.
