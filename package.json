{
  "name": "buildergame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/validate.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "snapshot": "node scripts/capture.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
