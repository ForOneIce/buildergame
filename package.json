{
  "name": "buildergame",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/validate.mjs && vite build && node scripts/static-towns.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "snapshot": "node scripts/capture.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.42.0",
    "ethers": "6.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
